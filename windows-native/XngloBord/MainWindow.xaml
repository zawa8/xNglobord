<Window x:Class="XngloBord.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="xNglobord" Height="330" Width="520"
        WindowStyle="ToolWindow"
        ResizeMode="CanResizeWithGrip"
        Topmost="True"
        ShowInTaskbar="False"
        Background="#FFEDEDED">
    <DockPanel Margin="4">
        <!-- Top bar: font picker -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2">
            <TextBlock Text="Font:" VerticalAlignment="Center" Margin="0,0,4,0" />
            <ComboBox x:Name="FontCombo" Width="160" SelectionChanged="FontCombo_SelectionChanged" />
            <TextBlock Text="  (click your target app first, then click keys)"
                       VerticalAlignment="Center" Foreground="#FF555555" Margin="8,0,0,0" FontSize="11" />
        </StackPanel>

        <!-- Candidates strip -->
        <WrapPanel x:Name="CandidatesPanel" DockPanel.Dock="Top" Orientation="Horizontal" Margin="2" />

        <!-- Key grid, built in code-behind from Layouts.Letters/Numeric -->
        <StackPanel x:Name="KeysPanel" DockPanel.Dock="Top" Margin="2" />
    </DockPanel>
</Window>
