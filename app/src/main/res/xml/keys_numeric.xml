<?xml version="1.0" encoding="utf-8"?>
<!--
  Numbers/symbols page, per kiz_pez_le-aut.md. Reached from the main
  xi38 layout's "?123" key (codes=-2) and returned from via this
  page's own "xyz" key (same code): see the mode-switch tap-count
  handling (handleModeSwitchTap) in XngloIME.kt's onKey().

  Digits/symbols aren't part of xi38 dictionary tracking (see
  XngloIME's commitOrdinaryChar), so no popupCharacters/aspiration
  logic applies here.

  Layout (5 rows, per kiz_pez_le-aut.md):
    0 1 2 3 + - / * % =
    4 5 6 7 E U I O M X
    8 9 L Y _ @ # $ & *
    V W P F ( [ { ) ] }
    xyz ' ` ~ | ^ \ ? .

  Colors: all 16 hex digits (0-9, L Y V W P F) yellow; E U I O M X
  pink (XngloKeyboardView.colorForLabel/OPERATOR_LETTERS).

  E U I O M X are literal letter keys (codes 69/85/73/79/77/88, same
  as any other key): NOT the actual operator symbols ==, !=, >=,
  <=, &&, || (an earlier version of this file used keyOutputText to
  output those symbols directly, which was wrong). The intent is the
  same hscii trick used throughout xNglo: a custom font (one of the
  xNglo hscii fonts) remaps these letter glyphs to *display* as those
  operator symbols, without changing what character actually gets
  typed. So the key always outputs plain E/U/I/O/M/X; only the visual
  glyph changes when an hscii font is selected.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:horizontalGap="0px"
    android:verticalGap="2px"
    android:keyHeight="@dimen/key_height">

    <Row>
        <Key android:codes="48" android:keyLabel="0" android:keyEdgeFlags="left" />
        <Key android:codes="49" android:keyLabel="1" />
        <Key android:codes="50" android:keyLabel="2" />
        <Key android:codes="51" android:keyLabel="3" />
        <Key android:codes="43" android:keyLabel="+" />
        <Key android:codes="45" android:keyLabel="-" />
        <Key android:codes="47" android:keyLabel="/" />
        <Key android:codes="42" android:keyLabel="*" />
        <Key android:codes="37" android:keyLabel="%" />
        <Key android:codes="61" android:keyLabel="=" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="52" android:keyLabel="4" android:keyEdgeFlags="left" />
        <Key android:codes="53" android:keyLabel="5" />
        <Key android:codes="54" android:keyLabel="6" />
        <Key android:codes="55" android:keyLabel="7" />
        <Key android:codes="69" android:keyLabel="E" />
        <Key android:codes="85" android:keyLabel="U" />
        <Key android:codes="73" android:keyLabel="I" />
        <Key android:codes="79" android:keyLabel="O" />
        <Key android:codes="77" android:keyLabel="M" />
        <Key android:codes="88" android:keyLabel="X" android:keyEdgeFlags="right" />
    </Row>

    <!-- L Y V W P F: xi38's own letters for hex 10-15, replacing the standard A-F. -->
    <Row>
        <Key android:codes="56" android:keyLabel="8" android:keyEdgeFlags="left" />
        <Key android:codes="57" android:keyLabel="9" />
        <Key android:codes="76" android:keyLabel="L" />
        <Key android:codes="89" android:keyLabel="Y" />
        <Key android:codes="95" android:keyLabel="_" />
        <Key android:codes="34" android:keyLabel="\"" />
        <Key android:codes="35" android:keyLabel="#" />
        <Key android:codes="36" android:keyLabel="$" />
        <Key android:codes="38" android:keyLabel="&amp;" />
        <Key android:codes="42" android:keyLabel="*" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="86" android:keyLabel="V" android:keyEdgeFlags="left" />
        <Key android:codes="87" android:keyLabel="W" />
        <Key android:codes="80" android:keyLabel="P" />
        <Key android:codes="70" android:keyLabel="F" />
        <Key android:codes="40" android:keyLabel="(" />
        <Key android:codes="91" android:keyLabel="[" />
        <Key android:codes="123" android:keyLabel="{" />
        <Key android:codes="41" android:keyLabel=")" />
        <Key android:codes="93" android:keyLabel="]" />
        <Key android:codes="125" android:keyLabel="}" android:keyEdgeFlags="right" />
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-2" android:keyLabel="xyz" android:keyWidth="11%p" android:keyEdgeFlags="left" />
        <Key android:codes="39" android:keyLabel="'" android:keyWidth="11%p" />
        <Key android:codes="96" android:keyLabel="`" android:keyWidth="11%p" />
        <Key android:codes="126" android:keyLabel="~" android:keyWidth="11%p" />
        <Key android:codes="124" android:keyLabel="|" android:keyWidth="11%p" />
        <Key android:codes="94" android:keyLabel="^" android:keyWidth="11%p" />
        <Key android:codes="92" android:keyLabel="\\" android:keyWidth="11%p" />
        <Key android:codes="63" android:keyLabel="\?" android:keyWidth="11%p" />
        <Key android:codes="46" android:keyLabel="." android:keyWidth="12%p" android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
