<?xml version="1.0" encoding="utf-8"?>
<!--
  Real xi38 layout, replacing keys_placeholder.xml.

  Key insight: the 26 lowercase xi38 base graphemes (x a i u e o n h c g
  k p f b m y r l w s v j q t d z) are literally the ordinary Latin
  a-z letters: so the physical layout is just standard QWERTY, no
  relabeling needed. That covers 26 of the 38 sounds directly.

  The remaining 12 come from two places:
    - N and R: long-press on n / r gives the capital form, same as
      every other key's long-press-caps behavior. This is handled
      entirely in Kotlin (XngloIME's onPress/onRelease + a Handler
      timer, same pattern as the spacebar's long-press font picker):
      NOT via android:popupCharacters. That attribute triggers the
      framework's own built-in mini-keyboard popup, which is a
      separate internal KeyboardView instance our XngloKeyboardView
      customizations don't reach, so it rendered as a plain white
      unthemed rectangle. Handling long-press ourselves avoids the
      framework popup entirely.
    - K G C Z T D J Q B S: NOT separate keys. Per the spec, typing h
      right after k/g/c/z/t/d/j/q/b/s replaces that letter with its
      aspirated capital form instead of inserting a literal h. See the
      onKey() h-suffix handling in XngloIME.kt. Standalone h (not
      preceded by one of those 10) just inserts "h" normally.

  Long-press on every a-z key (not just n/r) inserts its capital form,
  same Kotlin-side mechanism (LONG_PRESS_MS in XngloIME.kt). A shift
  key (codes=-1) is also available for the same result via two taps
  (shift, then the letter) instead of one long-press: one-shot,
  reverts to lowercase after the next letter. See onKey()'s
  SHIFT_CODE handling and isShiftActive in XngloIME.kt.
-->
<Keyboard xmlns:android="http://schemas.android.com/apk/res/android"
    android:keyWidth="10%p"
    android:horizontalGap="0px"
    android:verticalGap="2px"
    android:keyHeight="@dimen/key_height">

    <Row>
        <Key android:codes="113" android:keyLabel="q" android:keyEdgeFlags="left" />
        <Key android:codes="119" android:keyLabel="w" />
        <Key android:codes="101" android:keyLabel="e" />
        <Key android:codes="114" android:keyLabel="r" />
        <Key android:codes="116" android:keyLabel="t" />
        <Key android:codes="121" android:keyLabel="y" />
        <Key android:codes="117" android:keyLabel="u" />
        <Key android:codes="105" android:keyLabel="i" />
        <Key android:codes="111" android:keyLabel="o" />
        <Key android:codes="112" android:keyLabel="p" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="97" android:keyLabel="a" android:keyEdgeFlags="left" android:horizontalGap="5%p" />
        <Key android:codes="115" android:keyLabel="s" />
        <Key android:codes="100" android:keyLabel="d" />
        <Key android:codes="102" android:keyLabel="f" />
        <Key android:codes="103" android:keyLabel="g" />
        <Key android:codes="104" android:keyLabel="h" />
        <Key android:codes="106" android:keyLabel="j" />
        <Key android:codes="107" android:keyLabel="k" />
        <Key android:codes="108" android:keyLabel="l" android:keyEdgeFlags="right" />
    </Row>

    <Row>
        <Key android:codes="-1" android:keyLabel="⇧" android:keyWidth="12%p" android:keyEdgeFlags="left" />
        <Key android:codes="122" android:keyLabel="z" android:keyWidth="11%p" />
        <Key android:codes="120" android:keyLabel="x" android:keyWidth="11%p" />
        <Key android:codes="99" android:keyLabel="c" android:keyWidth="11%p" />
        <Key android:codes="118" android:keyLabel="v" android:keyWidth="11%p" />
        <Key android:codes="98" android:keyLabel="b" android:keyWidth="11%p" />
        <Key android:codes="110" android:keyLabel="n" android:keyWidth="11%p" />
        <Key android:codes="109" android:keyLabel="m" android:keyWidth="11%p" />
        <Key android:codes="-5" android:keyLabel="⌫" android:keyWidth="11%p" android:isRepeatable="true" android:keyEdgeFlags="right" />
    </Row>

    <Row android:rowEdgeFlags="bottom">
        <Key android:codes="-2" android:keyLabel="\?123" android:keyWidth="16%p" android:keyEdgeFlags="left" />
        <Key android:codes="44" android:keyLabel="," android:keyWidth="10%p" />
        <Key android:codes="32" android:keyLabel="long-press: change font" android:keyWidth="40%p" />
        <Key android:codes="46" android:keyLabel="." android:keyWidth="10%p" />
        <Key android:codes="-4" android:keyLabel="⏎" android:keyWidth="20%p" android:keyEdgeFlags="right" />
    </Row>

</Keyboard>
